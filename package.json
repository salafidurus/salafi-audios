{
  "name": "salafi-durus",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "infra/*",
      "packages/*",
      "scripts"
    ],
    "catalog": {
      "@better-auth/expo": "1.7.2",
      "@casl/ability": "7.0.1",
      "@prisma/adapter-pg": "7.10.0",
      "@prisma/client": "7.10.0",
      "@tanstack/react-query": "^5.102.4",
      "better-auth": "1.7.2",
      "i18next": "^26.4.0",
      "pg": "8.23.0",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "react-i18next": "17.0.12",
      "rimraf": "6.1.3",
      "tsup": "^8.5.1",
      "zod": "^4.4.3",
      "zustand": "5.0.15",
      "@types/node": "26.3.0",
      "@types/react": "~19.2.14",
      "dotenv": "^17.4.2",
      "@babel/core": "7.29.7",
      "@babel/runtime": "^7.29.7",
      "bun-types": "^1.4.0",
      "@testing-library/react": "^16.3.2",
      "@happy-dom/global-registrator": "^20.11.6"
    }
  },
  "scripts": {
    "agents:update": "bun run --filter @sd/scripts sync-agents",
    "dependabot-helper": "bun run --filter dependabot-helper cli",
    "dead-code-audit": "cd scripts && bun run --silent dead-code-audit",
    "dev": "turbo watch dev --filter=api --filter=web --filter=native",
    "dev:api": "turbo watch dev --filter=api",
    "dev:web": "turbo run dev --filter=web",
    "dev:native": "turbo run dev --filter=native",
    "dev:api+web": "turbo watch dev --filter=api --filter=web",
    "dev:native:build:android": "bun run --elide-lines=0 --filter native android",
    "dev:native:build:ios": "bun run --elide-lines=0 --filter native ios",
    "dev:native:clean-build:android": "bun run --elide-lines=0 --filter native prebuild:clean && bun run --elide-lines=0 --filter native android",
    "dev:native:clean-build:ios": "bun run --elide-lines=0 --filter native prebuild:clean && bun run --elide-lines=0 --filter native ios",
    "build": "turbo run build --affected",
    "build:all": "turbo run build",
    "build:api": "turbo run build --filter=api...",
    "build:web": "turbo run build --filter=web...",
    "build:native": "turbo run build --filter=native...",
    "build:android": "bun run --elide-lines=0 --filter native android",
    "lint": "turbo run lint --affected",
    "lint:all": "turbo run lint",
    "typecheck": "turbo run typecheck --affected",
    "typecheck:all": "turbo run typecheck",
    "test": "turbo run test --affected",
    "test:all": "turbo run test",
    "test:e2e": "turbo run test:e2e --affected",
    "test:e2e:all": "turbo run test:e2e",
    "test:prepush": "turbo run test:prepush --affected",
    "test:dead-code-audit": "bun run --filter @sd/scripts test:dead-code-audit",
    "verify:build-configs": "bun run --filter @sd/scripts verify-build-configs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "clean": "turbo run clean",
    "clean:hard": "(turbo run clean || true) && rimraf node_modules .turbo \"**/node_modules\" \"**/.next\" \"**/dist\" \"**/build\" \"**/coverage\"",
    "local-clean": "rimraf node_modules **/node_modules **/.turbo .turbo",
    "prepare": "husky",
    "lint:staged": "lint-staged --relative --concurrent false",
    "mddoc:quality": "markdownlint-cli2 README.md **/README.md docs/**/*.md AGENT.md CONTRIBUTING.md .github/copilot-instructions.md '!.serena/**/*.md'",
    "tsdoc:quality": "oxlint --config .oxlintrc.tsdoc.json --disable-nested-config apps packages",
    "security:secrets": "secretlint \"**/*\"",
    "doctor": "bun run react-doctor --verbose",
    "native:expo:fix": "bun run --elide-lines=0 --filter native expo:fix",
    "native:expo:check": "bun run --elide-lines=0 --filter native expo:check"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/runtime": "catalog:",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@happy-dom/global-registrator": "catalog:",
    "@oxlint/plugins": "1.80.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "bun-types": "^1.4.2",
    "husky": "9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "17.4.1",
    "markdownlint-cli2": "0.23.2",
    "oxfmt": "^0.65.0",
    "oxlint": "1.80.0",
    "oxlint-config-universe": "^0.2.0",
    "oxlint-plugin-react-doctor": "^0.9.12",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "catalog:",
    "react-doctor": "^0.9.12",
    "rimraf": "catalog:",
    "secretlint": "^13.0.5",
    "tsup": "catalog:",
    "tsx": "4.23.13",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "unplugin-swc": "^1.5.11"
  },
  "engines": {
    "bun": "1.4.2",
    "node": "22.x"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "@sentry/cli"
  ]
}
