# Local API env template.
# Copy to one of:
# - .env
# - .env.local
# - .env.development.local

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
CORS_ORIGINS_NATIVE=salafidurus-dev://,exp://

# Optional Redis. Without it, cache/throttling use local behavior and progress
# writes go directly to PostgreSQL.
REDIS_URL=redis://localhost:6379
TRUST_PROXY_HOPS=0

# Primary transactional database URLs.
PRIMARY_DATABASE_URL=postgresql://sd_dev:password@localhost:5432/salafi_dev?schema=public
PRIMARY_DIRECT_DATABASE_URL=postgresql://sd_dev:password@localhost:5432/salafi_dev?schema=public
PRIMARY_SHADOW_DATABASE_URL=postgresql://sd_dev:password@localhost:5432/salafi_dev_shadow?schema=public

# Dedicated analytics event archive.
# May point at the same database as PRIMARY_DATABASE_URL; analytics Prisma
# models are explicitly qualified into the analytics PostgreSQL schema.
ANALYTICS_DATABASE_URL=postgresql://sd_dev:password@localhost:5432/salafi_dev?schema=analytics
ANALYTICS_IDENTITY_HMAC_SECRET=replace-with-at-least-32-characters

# Neon control-plane credentials for the /health compute-endpoint status
# check. Optional in local development; required together, and required in
# every non-development environment (preview and production).
# NEON_API_KEY=
# NEON_PROJECT_ID=
# NEON_ENDPOINT_ID=ep-example-endpoint

# Set true only when SQL query events are needed for debugging.
PRISMA_LOG_QUERIES=false

# Optional CDN base URL for public media.
ASSET_CDN_BASE_URL=https://cdn.example.com

# Canonical web origin for sitemap <loc> URLs (production only).
# Example: https://www.salafidurus.com
SITEMAP_BASE_URL=

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000
COOKIE_DOMAIN=localhost

# OAuth
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
APPLE_CLIENT_ID=replace-me
APPLE_CLIENT_SECRET=replace-me

# R2 Account Details
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=replace-me
R2_PUBLIC_BASE_URL=replace-me
R2_PRESIGN_EXPIRES_SECONDS=3600

# Product analytics and OpenTelemetry (consumed by downstream analytics work).
# Keep each environment's values separate. Never commit real secrets or print
# them in logs.
# (SECRETS) Environment-specific Mixpanel project token.
MIXPANEL_PROJECT_TOKEN=replace-with-environment-project-token

# (PUBLIC) OpenTelemetry service name and exporter routing.
OTEL_SERVICE_NAME=salafi-durus-api
OTEL_ENVIRONMENT=development
OTEL_REGION=unknown
OTEL_DEPLOYMENT_VERSION=unknown
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net
# Use https://otlp.eu01.nr-data.net for an EU New Relic account.
# (SECRETS) Environment-specific New Relic license key header.
OTEL_EXPORTER_OTLP_HEADERS=api-key=replace-with-environment-license-key
# (PUBLIC) Exporter behavior and payload limits.
OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT=4095
OTEL_EXPORTER_OTLP_COMPRESSION=gzip
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
