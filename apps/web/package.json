{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "RUST_BACKTRACE=1 bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "oxlint .",
    "test": "bun test --isolate --path-ignore-patterns 'e2e/'",
    "test:watch": "bun test --watch --path-ignore-patterns 'e2e/'",
    "test:cov": "bun test --isolate --coverage --path-ignore-patterns 'e2e/'",
    "test:prepush": "bun test --isolate --path-ignore-patterns 'e2e/'",
    "test:e2e": "BUN_WEBVIEW_E2E=1 bun test --config ./bunfig.e2e.toml --timeout 120000 --retry 2 ./e2e/journeys/*.bun.e2e.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@casl/ability": "catalog:",
    "@sd/core-api": "workspace:*",
    "@sd/core-contracts": "workspace:*",
    "@sd/core-i18n": "workspace:*",
    "@sd/core-sync": "workspace:*",
    "@sd/design-tokens": "workspace:*",
    "@sd/domain-account": "workspace:*",
    "@sd/domain-audio": "workspace:*",
    "@sd/domain-content": "workspace:*",
    "@sd/domain-legal": "workspace:*",
    "@sd/domain-search": "workspace:*",
    "@sd/utils-error": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "i18next": "catalog:",
    "lucide-react": "^1.37.0",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "^19",
    "tailwindcss": "^4"
  }
