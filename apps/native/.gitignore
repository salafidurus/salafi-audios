# generated native folders
/ios

# android is regenerated by `expo prebuild`, except the debug keystore -
# committed so its SHA-1 stays stable across machines/CI for native Google
# Sign-In (a fresh auto-generated keystore breaks it with DEVELOPER_ERROR).
# See docs/auth.md.
/android/*
!/android/app
/android/app/*
!/android/app/debug.keystore
