# Local Expo / EAS env template.
# Copy to .env.local for local Expo work.

APP_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:4000
# Google's *Web* OAuth client id (same value as apps/api's GOOGLE_CLIENT_ID).
# Required by GoogleSignin.configure({ webClientId }) so native idToken sign-in
# is audienced to the client id the backend verifies against.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace-me

# Sentry / Vexo
SENTRY_AUTH_TOKEN=not-needed-for-dev
EXPO_PUBLIC_SENTRY_DSN=https://notNeededPublicKey@o0.ingest.sentry.io/0
EXPO_PUBLIC_SENTRY_ORG=not-needed-for-dev
EXPO_PUBLIC_SENTRY_PROJECT=not-needed-for-dev
EXPO_PUBLIC_VEXO_PROJECT_ID=not-needed-for-dev
