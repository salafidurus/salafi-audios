# Local Prisma / DB env template.
# Used by core-db scripts with precedence:
# .env -> .env.local -> .env.<NODE_ENV> -> .env.<NODE_ENV>.local

# Primary database URLs.
PRIMARY_DATABASE_URL=postgresql://sd_dev:password@localhost:5432/salafi_dev?schema=public
PRIMARY_DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require
PRIMARY_SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME_shadow?sslmode=require

# Dedicated analytics database URL.
ANALYTICS_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME_analytics?sslmode=require

# Media CDN base URL for audio assets (dev should use placeholder or local)
MEDIA_CDN_BASE_URL=https://placeholder.dev/audio
