{
  "name": "@sd/core-db",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "oxlint .",
    "pretest": "bun run prisma:generate",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage",
    "pretest:prepush": "bun run prisma:generate",
    "test:prepush": "bun test",
    "pretypecheck": "bun run prisma:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "primary:prisma:studio": "prisma studio --schema=./prisma/primary/schema.prisma --config=./prisma.primary.config.ts",
    "prisma:generate": "bun ./scripts/generate-prisma.js",
    "analytics:prisma:generate": "prisma generate --schema=./prisma/analytics/schema.prisma --config=./prisma.analytics.config.ts",
    "primary:prisma:format": "prisma format --schema=./prisma/primary/schema.prisma --config=./prisma.primary.config.ts",
    "analytics:prisma:format": "prisma format --schema=./prisma/analytics/schema.prisma --config=./prisma.analytics.config.ts",
    "prisma:format": "bun run primary:prisma:format && bun run analytics:prisma:format",
    "primary:prisma:validate": "prisma validate --schema=./prisma/primary/schema.prisma --config=./prisma.primary.config.ts",
    "analytics:prisma:validate": "prisma validate --schema=./prisma/analytics/schema.prisma --config=./prisma.analytics.config.ts",
    "prisma:validate": "bun run primary:prisma:validate && bun run analytics:prisma:validate",
    "prisma:seed": "bun run scripts/seed.ts",
    "grant:access": "bun ./scripts/grant-access.ts",
    "primary:migrate:reset:seed": "prisma migrate reset --force --schema=./prisma/primary/schema.prisma --config=./prisma.primary.config.ts && bun run prisma:seed",
    "primary:migrate:reset": "prisma migrate reset --force --schema=./prisma/primary/schema.prisma --config=./prisma.primary.config.ts",
    "primary:migrate:create-only": "bun ./scripts/migrate-with-auto-name.js primary",
    "primary:migrate:deploy": "prisma migrate deploy --schema=./prisma/primary/schema.prisma --config=./prisma.primary.config.ts",
    "analytics:migrate:create-only": "bun ./scripts/migrate-with-auto-name.js analytics",
    "analytics:migrate:deploy": "prisma migrate deploy --schema=./prisma/analytics/schema.prisma --config=./prisma.analytics.config.ts",
    "build": "bun ./scripts/build.js",
    "dev": "bun run build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@prisma/client-runtime-utils": "7.10.0",
    "@sd/core-contracts": "workspace:*"
  },
  "devDependencies": {
    "dotenv": "catalog:",
    "pg": "catalog:",
    "prisma": "7.10.0",
    "tsup": "catalog:"
  }
}
